{
  "name": "etn-nft-launchpad",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "compile": "hardhat compile",
    "export:verification": "node scripts/export-verification-artifact.mjs",
    "export:verification:all": "node scripts/export-verification-artifacts.mjs",
    "export:verification:legacy": "node scripts/export-factory-verification-artifact.mjs",
    "export:verification:current": "node scripts/export-verification-artifact.mjs",
    "test:contracts": "hardhat test",
    "deploy:testnet": "hardhat run scripts/deploy.cjs --network electroneumTestnet",
    "deploy:v2:testnet": "hardhat run scripts/deploy-v2-factories.cjs --network electroneumTestnet",
    "deploy:v2:mainnet": "hardhat run scripts/deploy-v2-factories.cjs --network electroneum",
    "deploy:mainnet": "hardhat run scripts/deploy.cjs --network electroneum",
    "verify:collection": "node scripts/verify-collection.cjs",
    "factory:config": "node scripts/set-factory-config.cjs testnet",
    "factory:config:mainnet": "node scripts/set-factory-config.cjs mainnet",
    "factory:publish-fee": "node scripts/set-publish-fee.cjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@reown/appkit": "^1.8.23",
    "@reown/appkit-adapter-wagmi": "^1.8.23",
    "@supabase/supabase-js": "^2.109.0",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-router-dom": "^7.18.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "viem": "^2.55.19",
    "wagmi": "^3.7.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@openzeppelin/contracts": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@typechain/ethers-v6": "^0.5.0",
    "@types/chai": "^4.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "chai": "^6.2.2",
    "ethers": "^6.17.0",
    "hardhat": "^2.28.0",
    "hardhat-gas-reporter": "^1.0.8",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "solidity-coverage": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
